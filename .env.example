# =============================================================================
# CivicSense AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# ----- Application -----
APP_NAME=CivicSense AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
# Keep API startup lightweight while integrations are being developed.
PROVIDER_MODE=mock
# Reverse geocoding stays mock until explicitly enabled.
LOCATION_PROVIDER=mock
AUTHORITY_PROVIDER=mock
COMPLAINT_REPOSITORY=memory
DUPLICATE_PROVIDER=mock
ANALYTICS_PROVIDER=mock
# Set a random value of at least 16 characters before accepting index syncs.
# COMPLAINT_INDEX_API_KEY=<your-random-secret>
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=CivicSenseAI/0.1

# ----- AI Service -----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
API_V1_PREFIX=/api/v1

# ----- Model Paths -----
MODEL_DIR=./models
# Path to the trained civic issue YOLO model.
# For local architecture testing (Phase 2/3), you can use the generic COCO model:
# YOLO_MODEL_PATH=yolov8n.pt
YOLO_MODEL_PATH=./models/civicsense_yolo.pt

# ----- Qdrant (Vector Database — Phase 6) -----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=civicsense_docs

# ----- Ollama (Local LLM — Phase 7) -----
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# ----- Redis (Caching — Future) -----
REDIS_URL=redis://localhost:6379/0

# ----- PostgreSQL (Database — Future) -----
DATABASE_URL=postgresql://user:password@localhost:5432/civicsense

# ----- BGE Embeddings (Phase 6) -----
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5
