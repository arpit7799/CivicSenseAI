# =============================================================================
# CivicSense AI — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# ----- Application -----
APP_NAME=CivicSense AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ----- AI Service -----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
API_V1_PREFIX=/api/v1

# ----- Model Paths -----
MODEL_DIR=./models
# Path to the trained civic issue YOLO model.
# For local architecture testing (Phase 2/3), you can use the generic COCO model:
# YOLO_MODEL_PATH=yolov8n.pt
YOLO_MODEL_PATH=./models/civicsense_yolo.pt

# ----- Qdrant (Vector Database — Phase 6) -----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=civicsense_docs

# ----- Ollama (Local LLM — Phase 7) -----
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2

# ----- Redis (Caching — Future) -----
REDIS_URL=redis://localhost:6379/0

# ----- PostgreSQL (Database — Future) -----
DATABASE_URL=postgresql://user:password@localhost:5432/civicsense

# ----- BGE Embeddings (Phase 6) -----
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5
