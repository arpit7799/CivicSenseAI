# =============================================================================
# CivicSense AI — .gitignore
# =============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# ----- Virtual Environments -----
civicsenseAI_env/
venv/
.venv/
env/

# ----- Environment / Secrets -----
.env
.env.local
.env.*.local

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Model Weights & Checkpoints -----
backend/models/*.pt
backend/models/*.pth
backend/models/*.onnx
backend/models/*.bin
backend/models/*.safetensors
backend/models/training_runs/
backend/yolov8n.pt
runs/
!backend/models/.gitkeep

# ----- Datasets (large files) -----
backend/datasets/*.zip
backend/datasets/*.tar.gz
backend/datasets/images/
backend/datasets/civic_dataset/images/
backend/datasets/**/*.cache
!backend/datasets/.gitkeep

# ----- Qdrant Data -----
qdrant_data/
qdrant_storage/

# ----- Logs -----
logs/
*.log

# ----- Test / Coverage -----
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ----- Docker -----
docker-compose.override.yml

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Node (for future frontend) -----
node_modules/
.next/
out/
